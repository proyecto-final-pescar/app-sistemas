generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model asistente_virtual {
  asistente_virtual_id String    @id @db.Char(3)
  nombre               String    @unique @db.VarChar(30)
  usuario              usuario[]
}

model categoria_servicio {
  categoria_servicio_id String     @id @db.Char(3)
  nombre                String     @unique @db.VarChar(30)
  consulta              consulta[]
  servicio              servicio[]
}

model consulta {
  consulta_id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mascota_id            String             @db.Uuid
  profesional_id        String             @db.Uuid
  veterinaria_id        String             @db.Uuid
  turno_id              String             @unique @db.Uuid
  fecha                 DateTime           @db.Date
  hora                  DateTime           @db.Time(6)
  categoria_servicio_id String             @db.Char(3)
  motivo_consulta       String
  anotaciones           String
  monto                 Decimal?           @default(0) @db.Decimal(12, 2)
  url_pdf               String?
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  categoria_servicio    categoria_servicio @relation(fields: [categoria_servicio_id], references: [categoria_servicio_id], onDelete: NoAction, onUpdate: NoAction)
  mascota               mascota            @relation(fields: [mascota_id], references: [mascota_id], onDelete: NoAction, onUpdate: NoAction)
  profesional           profesional        @relation(fields: [profesional_id], references: [profesional_id], onDelete: NoAction, onUpdate: NoAction)
  turno                 turno              @relation(fields: [turno_id], references: [turno_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria           veterinaria        @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mascota_id], map: "ix_consulta_mascota")
}

model dia_semana {
  dia_semana_id       String                @id @db.Char(3)
  nombre              String                @unique @db.VarChar(30)
  horario_veterinaria horario_veterinaria[]
}

model especialidad {
  especialidad_id String        @id @db.Char(3)
  nombre          String        @unique @db.VarChar(50)
  profesional     profesional[]
}

model especie {
  especie_id String @id @db.Char(3)
  nombre     String @unique @db.VarChar(30)
  raza       raza[]
}

model estado_pago {
  estado_pago_id String @id @db.Char(3)
  nombre         String @unique @db.VarChar(30)
  pago           pago[]
}

model estado_publicacion {
  estado_publicacion_id String        @id @db.Char(3)
  nombre                String        @unique @db.VarChar(30)
  publicacion           publicacion[]
}

model estado_reporte {
  estado_reporte_id String    @id @db.Char(3)
  nombre            String    @unique @db.VarChar(30)
  reporte           reporte[]
}

model estado_turno {
  estado_turno_id String  @id @db.Char(3)
  nombre          String  @unique @db.VarChar(30)
  turno           turno[]
}

model estado_veterinaria {
  estado_veterinaria_id String        @id @db.Char(3)
  nombre                String        @unique @db.VarChar(30)
  veterinaria           veterinaria[]
}

model estudio {
  estudio_id     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mascota_id     String      @db.Uuid
  profesional_id String      @db.Uuid
  veterinaria_id String      @db.Uuid
  nombre         String      @db.VarChar(150)
  fecha          DateTime    @db.Date
  url_archivo    String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  mascota        mascota     @relation(fields: [mascota_id], references: [mascota_id], onDelete: NoAction, onUpdate: NoAction)
  profesional    profesional @relation(fields: [profesional_id], references: [profesional_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria    veterinaria @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)
}

model ficha_medica {
  ficha_medica_id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mascota_id              String   @unique @db.Uuid
  color_pelaje            String?  @db.VarChar(100)
  microchip               String?  @db.VarChar(15)
  enfermedades_cronicas   String?  @default("Ninguna")
  cirugias_previas        String?  @default("Ninguna")
  medicamentos_habituales String?  @default("Ninguno")
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  mascota                 mascota  @relation(fields: [mascota_id], references: [mascota_id], onDelete: NoAction, onUpdate: NoAction)
}

model horario_veterinaria {
  horario_veterinaria_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  veterinaria_id         String      @db.Uuid
  dia_semana_id          String      @db.Char(3)
  hora_desde             DateTime    @db.Time(6)
  hora_hasta             DateTime    @db.Time(6)
  dia_semana             dia_semana  @relation(fields: [dia_semana_id], references: [dia_semana_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria            veterinaria @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([veterinaria_id, dia_semana_id])
}

model mascota {
  mascota_id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dueno_id         String        @db.Uuid
  nombre           String        @db.VarChar(100)
  raza_id          Int           @db.SmallInt
  sexo_mascota_id  String        @db.Char(3)
  fecha_nacimiento DateTime      @db.Date
  foto             String
  es_castrado      Boolean       @default(false)
  peso             Decimal       @db.Decimal(5, 2)
  active           Boolean       @default(true)
  consulta         consulta[]
  estudio          estudio[]
  ficha_medica     ficha_medica?
  usuario          usuario       @relation(fields: [dueno_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  raza             raza          @relation(fields: [raza_id], references: [raza_id], onDelete: NoAction, onUpdate: NoAction)
  sexo_mascota     sexo_mascota  @relation(fields: [sexo_mascota_id], references: [sexo_mascota_id], onDelete: NoAction, onUpdate: NoAction)
  turno            turno[]
  vacuna           vacuna[]

  @@index([dueno_id], map: "ix_mascota_dueno")
  @@index([raza_id], map: "ix_mascota_raza")
}

model metodo_pago {
  metodo_pago_id String @id @db.Char(3)
  nombre         String @unique @db.VarChar(30)
  pago           pago[]
}

model motivo_reporte {
  motivo_reporte_id String    @id @db.Char(3)
  nombre            String    @unique @db.VarChar(30)
  reporte           reporte[]
}

model notificacion {
  notificacion_id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id           String            @db.Uuid
  tipo_notificacion_id String            @db.Char(3)
  mensaje              String
  leida                Boolean           @default(false)
  link                 String?
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  tipo_notificacion    tipo_notificacion @relation(fields: [tipo_notificacion_id], references: [tipo_notificacion_id], onDelete: NoAction, onUpdate: NoAction)
  usuario              usuario           @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id, leida], map: "ix_notificacion_usuario_leida")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pago {
  pago_id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turno_id         String       @db.Uuid
  monto            Decimal      @db.Decimal(12, 2)
  id_pago          String?      @unique @db.VarChar(100)
  metodo_pago_id   String?      @db.Char(3)
  estado_pago_id   String       @default("PEN") @db.Char(3)
  motivo_rechazo   String?      @db.VarChar(255)
  fecha_aprobacion DateTime?    @db.Timestamptz(6)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)

  reembolso_de_id String? @db.Uuid

  estado_pago      estado_pago  @relation(fields: [estado_pago_id], references: [estado_pago_id], onDelete: NoAction, onUpdate: NoAction)
  metodo_pago      metodo_pago? @relation(fields: [metodo_pago_id], references: [metodo_pago_id], onDelete: NoAction, onUpdate: NoAction)
  turno            turno        @relation(fields: [turno_id], references: [turno_id], onDelete: NoAction, onUpdate: NoAction)

  pago_original pago?  @relation("PagoReembolso", fields: [reembolso_de_id], references: [pago_id], onDelete: NoAction, onUpdate: NoAction)
  reembolsos    pago[] @relation("PagoReembolso")

  @@index([estado_pago_id], map: "ix_pago_estado")
  @@index([turno_id], map: "ix_pago_turno")
  @@index([reembolso_de_id], map: "ix_pago_reembolso_de")
}

model profesional {
  profesional_id       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  veterinaria_id       String                 @db.Uuid
  nombre               String                 @db.VarChar(100)
  apellido             String                 @db.VarChar(100)
  especialidad_id      String                 @db.Char(3)
  email                String?                @db.VarChar(255)
  active               Boolean                @default(true)
  consulta             consulta[]
  estudio              estudio[]
  especialidad         especialidad           @relation(fields: [especialidad_id], references: [especialidad_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria          veterinaria            @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)
  profesional_servicio profesional_servicio[]
  turno                turno[]
  turno_profesional    turno_profesional[]
  vacuna               vacuna[]
}

model profesional_servicio {
  profesional_id String      @db.Uuid
  servicio_id    String      @db.Uuid
  profesional    profesional @relation(fields: [profesional_id], references: [profesional_id], onDelete: NoAction, onUpdate: NoAction)
  servicio       servicio    @relation(fields: [servicio_id], references: [servicio_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([profesional_id, servicio_id])
}

model publicacion {
  publicacion_id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id            String             @db.Uuid
  foto                  String
  nombre                String?            @db.VarChar(100)
  zona_id               Int                @db.SmallInt
  descripcion           String
  fecha                 DateTime           @db.Date
  tipo_contacto_id      String             @db.Char(3)
  contacto              String             @db.VarChar(150)
  estado_publicacion_id String             @default("ACT") @db.Char(3)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  estado_publicacion    estado_publicacion @relation(fields: [estado_publicacion_id], references: [estado_publicacion_id], onDelete: NoAction, onUpdate: NoAction)
  tipo_contacto         tipo_contacto      @relation(fields: [tipo_contacto_id], references: [tipo_contacto_id], onDelete: NoAction, onUpdate: NoAction)
  usuario               usuario            @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  zona                  zona               @relation(fields: [zona_id], references: [zona_id], onDelete: NoAction, onUpdate: NoAction)
  reporte               reporte[]

  @@index([usuario_id], map: "ix_publicacion_usuario")
}

model raza {
  raza_id    Int       @id @db.SmallInt
  especie_id String    @db.Char(3)
  nombre     String    @db.VarChar(100)
  mascota    mascota[]
  especie    especie   @relation(fields: [especie_id], references: [especie_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([especie_id, nombre])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reporte {
  reporte_id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicacion_id    String         @db.Uuid
  usuario_id        String         @db.Uuid
  motivo_reporte_id String         @db.Char(3)
  descripcion       String?        @db.VarChar(300)
  estado_reporte_id String         @default("PEN") @db.Char(3)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  estado_reporte    estado_reporte @relation(fields: [estado_reporte_id], references: [estado_reporte_id], onDelete: NoAction, onUpdate: NoAction)
  motivo_reporte    motivo_reporte @relation(fields: [motivo_reporte_id], references: [motivo_reporte_id], onDelete: NoAction, onUpdate: NoAction)
  publicacion       publicacion    @relation(fields: [publicacion_id], references: [publicacion_id], onDelete: NoAction, onUpdate: NoAction)
  usuario           usuario        @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([publicacion_id, usuario_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resena {
  resena_id      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  veterinaria_id String      @db.Uuid
  usuario_id     String      @db.Uuid
  valor          Int         @db.SmallInt
  usuario        usuario     @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria    veterinaria @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([veterinaria_id, usuario_id])
}

model rol {
  rol_id  String    @id @db.Char(3)
  nombre  String    @unique @db.VarChar(30)
  usuario usuario[]
}

model servicio {
  servicio_id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  veterinaria_id        String                 @db.Uuid
  categoria_servicio_id String                 @db.Char(3)
  nombre                String                 @db.VarChar(150)
  precio                Decimal                @db.Decimal(12, 2)
  active                Boolean                @default(true)
  profesional_servicio  profesional_servicio[]
  categoria_servicio    categoria_servicio     @relation(fields: [categoria_servicio_id], references: [categoria_servicio_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria           veterinaria            @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)
  turno                 turno[]
}

model sexo_mascota {
  sexo_mascota_id String    @id @db.Char(3)
  nombre          String    @unique @db.VarChar(30)
  mascota         mascota[]
}

model tipo_contacto {
  tipo_contacto_id String        @id @db.Char(3)
  nombre           String        @unique @db.VarChar(30)
  publicacion      publicacion[]
}

model tipo_notificacion {
  tipo_notificacion_id String         @id @db.Char(3)
  nombre               String         @unique @db.VarChar(30)
  notificacion         notificacion[]
}

model turno {
  turno_id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  veterinaria_id       String    @db.Uuid
  profesional_id       String?   @db.Uuid
  servicio_id          String    @db.Uuid
  mascota_id           String?   @db.Uuid
  fecha                DateTime  @db.Date
  hora_inicio          DateTime  @db.Time(6)
  hora_fin             DateTime  @db.Time(6)
  motivo               String?   @db.VarChar(255)
  monto_servicio       Decimal   @db.Decimal(12, 2)
  estado_turno_id      String    @default("DIS") @db.Char(3)
  vence_en             DateTime? @db.Timestamptz(6)
  recordatorio_enviado Boolean   @default(false)
  notas                String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)

  consulta                    consulta?
  pago                        pago[]
  turno_profesional_candidato turno_profesional[] @relation("turno_candidatos")
  estado_turno                estado_turno        @relation(fields: [estado_turno_id], references: [estado_turno_id], onDelete: NoAction, onUpdate: NoAction)
  mascota                     mascota?            @relation(fields: [mascota_id], references: [mascota_id], onDelete: NoAction, onUpdate: NoAction)
  profesional                 profesional?        @relation(fields: [profesional_id], references: [profesional_id], onDelete: NoAction, onUpdate: NoAction)
  servicio                    servicio            @relation(fields: [servicio_id], references: [servicio_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria                 veterinaria         @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mascota_id], map: "ix_turno_mascota")
  @@index([estado_turno_id, fecha, recordatorio_enviado], map: "ix_turno_recordatorio")
  @@index([estado_turno_id, vence_en], map: "ix_turno_vencimiento")
}

model turno_profesional {
  turno_id       String @db.Uuid
  profesional_id String @db.Uuid

  turno       turno       @relation("turno_candidatos", fields: [turno_id], references: [turno_id], onDelete: Cascade, onUpdate: NoAction)
  profesional profesional @relation(fields: [profesional_id], references: [profesional_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([turno_id, profesional_id])
}

model usuario {
  usuario_id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre               String               @db.VarChar(100)
  apellido             String               @db.VarChar(100)
  email                String               @unique @db.VarChar(255)
  telefono             String?              @db.VarChar(20)
  zona_id              Int?                 @db.SmallInt
  foto_url             String?
  rol_id               String               @default("DUE") @db.Char(3)
  asistente_virtual_id String?              @default("PER") @db.Char(3)
  active               Boolean              @default(true)
  verificado           Boolean              @default(false)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  mascota              mascota[]
  notificacion         notificacion[]
  publicacion          publicacion[]
  reporte              reporte[]
  resena               resena[]
  asistente_virtual    asistente_virtual?   @relation(fields: [asistente_virtual_id], references: [asistente_virtual_id], onDelete: NoAction, onUpdate: NoAction)
  rol                  rol                  @relation(fields: [rol_id], references: [rol_id], onDelete: NoAction, onUpdate: NoAction)
  zona                 zona?                @relation(fields: [zona_id], references: [zona_id], onDelete: NoAction, onUpdate: NoAction)
  usuario_google_auth  usuario_google_auth?
  usuario_password     usuario_password?
  veterinaria          veterinaria?
}

model usuario_google_auth {
  usuario_id String   @id @db.Uuid
  google_id  String   @unique @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  usuario    usuario  @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
}

model usuario_password {
  usuario_id                 String    @id @db.Uuid
  password_hash              String    @db.VarChar(100)
  token_verificacion         String?   @db.VarChar(255)
  token_verificacion_expires DateTime? @db.Timestamptz(6)
  reset_password_token       String?   @db.VarChar(255)
  reset_password_expires     DateTime? @db.Timestamptz(6)
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime  @default(now()) @db.Timestamptz(6)
  usuario                    usuario   @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
}

model vacuna {
  vacuna_id      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mascota_id     String      @db.Uuid
  profesional_id String      @db.Uuid
  veterinaria_id String      @db.Uuid
  nombre         String      @db.VarChar(150)
  fecha_aplicada DateTime    @db.Date
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  mascota        mascota     @relation(fields: [mascota_id], references: [mascota_id], onDelete: NoAction, onUpdate: NoAction)
  profesional    profesional @relation(fields: [profesional_id], references: [profesional_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria    veterinaria @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)
}

model veterinaria {
  veterinaria_id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id              String                   @unique @db.Uuid
  nombre                  String                   @db.VarChar(150)
  direccion               String                   @db.VarChar(255)
  razon_social            String?                  @db.VarChar(150)
  cuit                    String                   @unique @db.VarChar(13)
  telefono                String                   @db.VarChar(20)
  email                   String                   @db.VarChar(255)
  sitio_web               String?
  latitud                 Decimal                  @db.Decimal(9, 6)
  longitud                Decimal                  @db.Decimal(9, 6)
  urgencias               Boolean                  @default(false)
  estado_veterinaria_id   String                   @default("PEN") @db.Char(3)
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                 @default(now()) @db.Timestamptz(6)
  consulta                consulta[]
  estudio                 estudio[]
  horario_veterinaria     horario_veterinaria[]
  profesional             profesional[]
  resena                  resena[]
  servicio                servicio[]
  turno                   turno[]
  vacuna                  vacuna[]
  estado_veterinaria      estado_veterinaria       @relation(fields: [estado_veterinaria_id], references: [estado_veterinaria_id], onDelete: NoAction, onUpdate: NoAction)
  usuario                 usuario                  @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  veterinaria_mercadopago veterinaria_mercadopago?

  @@index([usuario_id], map: "ix_veterinaria_usuario")
}

model veterinaria_mercadopago {
  veterinaria_id  String      @id @db.Uuid
  mp_user_id      String      @db.VarChar(50)
  access_token    String
  refresh_token   String
  public_key      String      @db.VarChar(255)
  token_expira_en DateTime    @db.Timestamptz(6)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)
  veterinaria     veterinaria @relation(fields: [veterinaria_id], references: [veterinaria_id], onDelete: NoAction, onUpdate: NoAction)
}

model zona {
  zona_id     Int           @id @db.SmallInt
  nombre      String        @unique @db.VarChar(50)
  publicacion publicacion[]
  usuario     usuario[]
}
